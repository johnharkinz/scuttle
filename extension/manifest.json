{
  "manifest_version": 3,
  "name": "Scuttle",
  "version": "0.1.0",
  "description": "Compare what the server sends with what JavaScript reveals, for the page you're viewing. Nothing is sent or stored.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scuttle",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "background": { "service_worker": "dist/background.js", "type": "module" },
  "permissions": ["activeTab", "scripting"]
}
